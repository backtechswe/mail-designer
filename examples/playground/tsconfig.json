{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@backtech/mail-designer": ["../../src/index.ts"],
      "@backtech/mail-designer/render": ["../../src/render/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
