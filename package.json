{
  "name": "@backtech/mail-designer",
  "version": "0.2.0",
  "description": "Block-based email designer for React. Zero-dependency table-based email HTML renderer, themeable via CSS variables, with a CLI and an MCP server.",
  "license": "MIT",
  "author": "BäckTech AB",
  "keywords": [
    "email",
    "email-builder",
    "email-editor",
    "email-template",
    "email-html",
    "react",
    "mjml-alternative",
    "drag-and-drop",
    "wysiwyg",
    "newsletter",
    "outlook",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtechswe/mail-designer.git"
  },
  "bugs": {
    "url": "https://github.com/backtechswe/mail-designer/issues"
  },
  "homepage": "https://github.com/backtechswe/mail-designer#readme",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin",
    "schema",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "default": "./dist/render/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "default": "./dist/locales/*.js"
    }
  },
  "bin": {
    "mail-designer": "bin/mail-designer.mjs"
  },
  "scripts": {
    "build": "tsc && cp src/styles.css dist/styles.css && node scripts/post-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "icons": "node scripts/build-icons.mjs",
    "dev": "npm --prefix examples/playground run dev",
    "clean": "rm -rf dist",
    "cli": "node bin/mail-designer.mjs",
    "prepublishOnly": "npm run clean && npm test"
  },
  "dependencies": {
    "i18next": "^25.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "typescript": "^5.7.3"
  }
}
